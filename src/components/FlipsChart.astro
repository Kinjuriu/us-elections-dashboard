---
// Chart 3: Senate seats that flipped. A small diverging bar per cycle
// (seats flipped to the Democrats above the line, to the Republicans
// below), then the table of flipped seats for the selected year. Clicking a
// cycle sets the shared year; the state names open the state view.
// src/scripts/flips-chart.ts redraws the table for other years.
import type { FlipsChart } from '../lib/chartData';
import { flipsTableHtml, flipsSentence } from '../lib/flipsText';

interface Props {
  chart: FlipsChart;
  year: number;
}
const { chart, year } = Astro.props;
const cyc = chart.cycles;
const n = cyc.length;
const HALF = 64;
const H = HALF * 2;
const top = chart.max + 1;
const h = (v: number) => (v / top) * HALF;
const colPct = 100 / n;
const x = (i: number) => +(i * colPct + colPct / 2).toFixed(3);
const rows = chart.rows.filter((r) => r.year === year);
const decided = cyc.find((c) => c.year === year)?.decided ?? 0;
---
<div class="fl" data-fl data-year={year}>
  <ul class="fl__legend" aria-label="Key">
    <li><span class="fl__sw" data-party="DEM"></span>Above the line: seats flipped to the Democrats</li>
    <li><span class="fl__sw" data-party="GOP"></span>Below: seats flipped to the Republicans</li>
  </ul>

  <div class="fl__cycles">
    <div class="fl__plot" aria-hidden="true">
      <svg viewBox={`0 0 100 ${H}`} preserveAspectRatio="none" style={`height:${H}px`}>
        {cyc.map((c, i) => {
          const bx = i * colPct + colPct * 0.2;
          const bw = colPct * 0.6;
          return (
            <>
              {c.toDem > 0 && <rect x={bx} y={HALF - h(c.toDem)} width={bw} height={h(c.toDem)} fill="var(--dem)" />}
              {c.toGop > 0 && <rect x={bx} y={HALF} width={bw} height={h(c.toGop)} fill="var(--gop)" />}
            </>
          );
        })}
        <line class="fl__zero" x1="0" x2="100" y1={HALF} y2={HALF} />
      </svg>
      <div class="fl__vals">
        {cyc.map((c, i) => (
          <>
            {c.toDem > 0 && <span style={`left:${x(i)}%;top:${HALF - h(c.toDem) - 17}px`}>{c.toDem}</span>}
            {c.toGop > 0 && <span style={`left:${x(i)}%;top:${HALF + h(c.toGop) + 1}px`}>{c.toGop}</span>}
            {c.decided === 0 && <span class="fl__none" style={`left:${x(i)}%;top:${HALF - 22}px`}>No results yet</span>}
          </>
        ))}
      </div>
    </div>
    <div class="fl__xaxis">
      {cyc.map((c, i) => (
        <button
          type="button"
          class:list={['fl__cycle', { 'is-major': c.year % 4 === 0 }]}
          data-year={c.year}
          aria-pressed={String(c.year === year)}
          aria-label={`${c.year}${c.year % 2 ? ' special elections' : ''}: ${c.decided === 0 ? 'results not yet entered' : `${c.toDem} seats flipped to the Democrats, ${c.toGop} to the Republicans`}. Show this year.`}
          style={`left:${(i * colPct).toFixed(3)}%;width:${colPct.toFixed(3)}%`}
        >
          <span class="fl__year">{c.year}</span>
        </button>
      ))}
    </div>
  </div>

  <h4 class="fl__head">Seats that changed party in <span data-fl-year>{year}</span></h4>
  <p class="fl__sentence" data-fl-sentence>{flipsSentence(rows, year, decided)}</p>
  <div class="fl__tablewrap" data-fl-table set:html={flipsTableHtml(rows, 'state')} />
  <script type="application/json" data-fl-data set:html={JSON.stringify({ rows: chart.rows, decided: Object.fromEntries(cyc.map((c) => [c.year, c.decided])) })}></script>
</div>

<script>
  import '../scripts/flips-chart';
</script>

<style>
  .fl__legend {
    list-style: none;
    margin: 0 0 var(--sp-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    font-size: var(--fs-1);
    color: var(--ink-2);
  }
  .fl__legend li { display: inline-flex; align-items: center; gap: 6px; }
  .fl :global(.fl__sw) { display: inline-block; width: 10px; height: 10px; flex: none; background: var(--ink-3); }
  .fl :global(.fl__sw[data-party='DEM']) { background: var(--dem); }
  .fl :global(.fl__sw[data-party='GOP']) { background: var(--gop); }
  .fl :global(.fl__sw[data-party='IND']) { background: var(--ind); }

  .fl__cycles { position: relative; max-width: 760px; }
  .fl__plot { position: relative; padding-block: 18px; }
  .fl__plot svg { display: block; width: 100%; overflow: visible; }
  .fl__zero { stroke: var(--ink); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .fl__vals { position: absolute; inset: 18px 0; }
  .fl__vals span {
    position: absolute;
    transform: translateX(-50%);
    font-family: var(--font-label);
    font-size: var(--fs-1);
    font-weight: 600;
    line-height: 16px;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .fl__vals .fl__none {
    width: 4em;
    text-align: center;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink-2);
  }
  .fl__xaxis { position: relative; height: 28px; }
  /* Each cycle's button covers its whole column, bars included. */
  .fl__cycle {
    position: absolute;
    bottom: 0;
    height: calc(28px + 18px * 2 + 128px);
    appearance: none;
    padding: 0 0 6px;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .fl__cycle:hover { background: color-mix(in srgb, var(--paper-2) 70%, transparent); }
  .fl__cycle[aria-pressed='true'] { box-shadow: inset 0 0 0 2px var(--ink); }
  .fl__cycle:focus-visible { outline: 2px solid var(--ink); outline-offset: 0; }
  .fl__year {
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .fl__cycle[aria-pressed='true'] .fl__year { color: var(--ink); }
  @container chart (max-width: 639.98px) {
    .fl__cycle:not(.is-major):not([aria-pressed='true']) .fl__year,
    /* Columns are narrow: a selected year's neighbours give it room. */
    .fl__cycle[aria-pressed='true'] + .fl__cycle .fl__year,
    .fl__cycle:has(+ .fl__cycle[aria-pressed='true']) .fl__year { visibility: hidden; }
    .fl__vals .fl__none { display: none; }
  }

  .fl__head {
    margin-top: var(--sp-6);
    font-family: var(--font-display);
    font-size: var(--fs-4);
  }
  .fl__sentence { margin-top: var(--sp-2); }
  .fl__tablewrap { margin-top: var(--sp-3); overflow-x: auto; }
  .fl :global(.fl__table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-2);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .fl :global(.fl__table th),
  .fl :global(.fl__table td) {
    padding: var(--sp-2) var(--sp-3) var(--sp-2) 0;
    border-bottom: var(--hairline);
    text-align: left;
    vertical-align: top;
  }
  .fl :global(.fl__table thead th) {
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-label);
    font-size: var(--fs-1);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    vertical-align: bottom;
  }
  .fl :global(.fl__table td .fl__sw) { margin-right: 6px; vertical-align: -1px; }
  .fl :global(.fl__num) { text-align: right; white-space: nowrap; }
  .fl :global(.fl__table thead th.fl__num) { text-align: right; padding-right: 0; }
  .fl :global(.fl__table td.fl__num) { padding-right: 0; }
  .fl :global(.fl__state),
  .fl :global(.fl__sort) {
    appearance: none;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .fl :global(.fl__state) { font-weight: 600; }
  .fl :global(.fl__state:hover),
  .fl :global(.fl__sort:hover) { text-decoration-thickness: 2px; }
  .fl :global(.fl__sort) { text-transform: inherit; letter-spacing: inherit; font-weight: 600; }
  .fl :global(.fl__arrow) { text-transform: none; letter-spacing: 0; font-weight: 500; }
  .fl :global(.fl__sub),
  .fl :global(.fl__label) { display: block; font-size: 12px; color: var(--ink-2); font-weight: 400; }
  .fl :global(tr.is-label) { color: var(--ink-2); }
  .fl :global(.fl__short) { display: none; }
  @container chart (max-width: 639.98px) {
    .fl :global(.fl__long) { display: none; }
    .fl :global(.fl__short) { display: inline; }
    .fl :global(.fl__table) { font-size: var(--fs-1); }
    .fl :global(.fl__table thead th) { letter-spacing: 0.04em; }
  }
</style>
