---
// The seat bars at the top of the page: House and Senate for the Congress
// elected in the selected year. With a comparison year set, each chamber
// shows both years, earlier above later, with the change written between
// them. Drawn at build time for the default year; src/scripts/header-bars.ts
// redraws them from the JSON block below.
import ChartFrame from './ChartFrame.astro';
import SeatBar from './SeatBar.astro';
import Footnote from './Footnote.astro';
import type { HeaderYear } from '../lib/dashboardData';
import { ordinal } from '../lib/mapText';

interface Props {
  years: Record<number, HeaderYear>;
  year: number;
  source: string;
  dataAsOf: string;
}
const { years, year, source, dataAsOf } = Astro.props;
const h = years[year];
const chambers = [
  { id: 'house', label: 'House', c: h.house, rowsWide: 5, rowsNarrow: 10 },
  { id: 'senate', label: 'Senate', c: h.senate, rowsWide: 2, rowsNarrow: 4 },
] as const;
const senateNote = h.senate.majorityNote;
---
<div class="hbars" data-hbars>
  <ChartFrame title={h.title} subtitle={h.subtitle} source={source} dataAsOf={dataAsOf} provisional>
    <p class="hbars__note" data-hb-note hidden={!h.note}>{h.note}</p>
    <div class="hbars__grid">
      {chambers.map((ch) => (
        <div class="hbars__col" data-chamber={ch.id}>
          {(['primary', 'compare'] as const).map((slot) => (
            <>
              {slot === 'compare' && <p class="hbars__change" data-hb-change hidden></p>}
              <div class="hbars__slot" data-slot={slot} hidden={slot === 'compare'}>
                <SeatBar
                  label={ch.label}
                  caption={ch.c.caption}
                  total={ch.c.total}
                  threshold={ch.c.threshold}
                  dem={ch.c.balance.dem}
                  gop={ch.c.balance.gop}
                  indDem={ch.c.balance.indDem}
                  indGop={ch.c.balance.indGop}
                  indUnknown={ch.c.balance.indUnknown}
                  other={ch.c.balance.other}
                  vacant={ch.c.balance.vacant}
                  rowsWide={ch.rowsWide}
                  rowsNarrow={ch.rowsNarrow}
                  provisional={ch.c.provisional}
                  dynamic
                />
              </div>
            </>
          ))}
        </div>
      ))}
    </div>
    <Fragment slot="notes">
      <Footnote>
        <span data-hb-control-note>{senateNote ? `Senate control. ${ordinal(h.congress)} Congress: ${senateNote}` : ''}</span>
      </Footnote>
      <Footnote>
        <span data-hb-ind-note>{h.senate.unverifiedInd || h.house.unverifiedInd
          ? 'The source gives the number of independents but not their caucus for this Congress; the caucus shown is still to be confirmed.'
          : ''}</span>
      </Footnote>
      <Footnote>
        With a comparison year set, the change is counted from the earlier Congress to the later one, using the seats each
        party held at the opening of each.
      </Footnote>
    </Fragment>
  </ChartFrame>
  <script type="application/json" data-hb-data set:html={JSON.stringify(years)}></script>
</div>

<script>
  import '../scripts/header-bars';
</script>

<style>
  .hbars__note {
    margin-bottom: var(--sp-4);
    padding: var(--sp-2) var(--sp-3);
    border-left: 2px solid var(--ink);
    background: var(--paper-2);
    font-size: var(--fs-2);
  }
  .hbars__note[hidden] { display: none; }
  .hbars__grid {
    display: grid;
    gap: var(--sp-7);
  }
  @media (min-width: 1024px) {
    .hbars__grid {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }
  .hbars__col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .hbars__slot[hidden],
  .hbars__change[hidden] { display: none; }
  .hbars__change {
    margin-block: var(--sp-4);
    padding-block: var(--sp-2);
    border-block: var(--hairline);
    font-family: var(--font-label);
    font-size: var(--fs-3);
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .hbars__change :global(.hbars__delta) { white-space: nowrap; }
  .hbars__change :global(.hbars__delta + .hbars__delta)::before {
    content: '';
    display: inline-block;
    width: var(--sp-4);
  }
  .hbars :global(.footnote:has(span:empty)) { display: none; }
</style>
