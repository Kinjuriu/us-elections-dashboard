---
// The board's one set of controls: the railway (or, on phones, the big-year
// stepper over a small railway), the chamber for the map, and a comparison
// year. Every module listens to the store these controls write to
// (src/scripts/control-strip.ts for chamber and comparison, src/scripts/railway.ts for the year).
import SegmentedControl from './SegmentedControl.astro';
import Railway from './Railway.astro';
import type { StoreConfig } from '../lib/store';
import type { StripColumn } from '../lib/dashboardData';

interface Props {
  config: StoreConfig;
  columns: StripColumn[];
}
const { config, columns } = Astro.props;
const allYears = [...config.years, ...config.senateOnlyYears].sort((a, b) => a - b);
const special = (y: number) => config.senateOnlyYears.includes(y);
const defaultChamber = config.defaultChamber;
---
<div class="cstrip" data-cbar>
  <div class="cstrip__year">
    <Railway config={config} columns={columns} year={config.defaultYear} trackStart={columns[0].year} />
  </div>
  <div class="cstrip__chamber">
    <SegmentedControl
      name="chamber"
      label="Chamber"
      compact
      options={[{ value: 'senate', label: 'Senate' }, { value: 'house', label: 'House' }]}
      selected={defaultChamber}
    />
  </div>
  <div class="cstrip__compare">
    <label class="cstrip__pick">
      <span class="label cstrip__compare-label">Compare with</span>
      <select class="cstrip__select" data-compare aria-label="Compare with another year">
        <option value="" data-short="Compare">None</option>
        {allYears.map((y) => (
          <option
            value={String(y)}
            data-only={special(y) ? 'senate' : undefined}
            hidden={special(y) && defaultChamber !== 'senate'}
            disabled={y === config.defaultYear}
          >{y}</option>
        ))}
      </select>
    </label>
    <button type="button" class="cstrip__stop" data-stop hidden>Stop comparing</button>
  </div>
  <noscript>
    <p class="cstrip__noscript">Showing the Senate in {config.defaultYear}. Turn on JavaScript to change the year or chamber.</p>
  </noscript>
</div>

<script>
  import '../scripts/control-strip';
</script>

<style>
  .cstrip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'year year'
      'chamber compare'
      'note note';
    align-items: center;
    gap: var(--sp-3) var(--sp-3);
    padding: var(--sp-4) var(--sp-3) var(--sp-3);
    background: var(--paper-2);
    border-bottom: 1px solid var(--rule);
    min-width: 0;
  }
  .cstrip__year { grid-area: year; min-width: 0; }
  .cstrip__chamber { grid-area: chamber; }
  .cstrip__compare {
    grid-area: compare;
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: var(--sp-2);
  }
  .cstrip__pick { display: flex; align-items: center; gap: var(--sp-2); }
  .cstrip__stop {
    appearance: none;
    min-height: 36px;
    padding: 5px var(--sp-3);
    border: 1px solid var(--ink);
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-label);
    font-size: var(--fs-1);
    font-weight: 600;
    cursor: pointer;
  }
  .cstrip__stop:hover { background: var(--paper-2); }
  .cstrip__stop:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .cstrip__stop[hidden] { display: none; }
  .cstrip__compare-label { display: none; }
  .cstrip__select {
    appearance: none;
    min-height: 36px;
    padding: 5px 26px 5px var(--sp-2);
    border: 1px solid var(--ink-3);
    border-radius: var(--radius-control);
    background:
      linear-gradient(45deg, transparent 50%, var(--ink) 50%) calc(100% - 13px) 50% / 5px 5px no-repeat,
      linear-gradient(135deg, var(--ink) 50%, transparent 50%) calc(100% - 8px) 50% / 5px 5px no-repeat,
      var(--paper);
    color: var(--ink);
    font-family: var(--font-label);
    font-size: var(--fs-1);
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .cstrip__select:hover { background-color: var(--paper-2); }
  .cstrip__select:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .cstrip__select[data-active] { border-color: var(--ink); background-color: var(--paper-2); }
  .cstrip__noscript { grid-area: note; font-size: var(--fs-1); color: var(--ink-2); }
  .cstrip :global(.segmented__button) { min-height: 36px; }

  @media (min-width: 900px) {
    .cstrip {
      grid-template-areas:
        'chamber compare'
        'year year'
        'note note';
      padding: var(--sp-3) var(--sp-4) var(--sp-3);
    }
    .cstrip__compare-label { display: block; }
  }
</style>
