---
// Squared toggle buttons for chamber or year. Native buttons with
// aria-pressed; Left/Right/Home/End move between options. On change the
// group fires a bubbling "segmentchange" event with { name, value }.
interface Option {
  value: string;
  label: string;
  /** A short second line in the button, e.g. "provisional". */
  note?: string;
  /** Only shown in one view (written as data-only, read by the page script). */
  only?: string;
  /** Accessible name when the visible label is not enough. */
  ariaLabel?: string;
}
interface Props {
  /** Group name, used in the change event and as a data attribute. */
  name: string;
  /** Accessible name for the group, e.g. "Chamber". */
  label: string;
  options: Option[];
  selected: string;
  /** Show the label as a visible tracked caption before the buttons. */
  showLabel?: boolean;
  /** Under 640px, keep the buttons on one line that scrolls sideways. */
  scroll?: boolean;
  /** Smaller buttons, for the control bar. */
  compact?: boolean;
}
const { name, label, options, selected, showLabel = false, scroll = false, compact = false } = Astro.props;
const labelId = `seg-${name}-label`;
---
<div class:list={['segmented', { 'segmented--scroll': scroll, 'segmented--compact': compact }]} data-segmented={name}>
  <span id={labelId} class:list={['label', 'segmented__label', { 'visually-hidden': !showLabel }]}>{label}</span>
  <div class="segmented__buttons" role="group" aria-labelledby={labelId}>
    {options.map((o) => (
      <button
        type="button"
        class="segmented__button"
        data-value={o.value}
        data-only={o.only}
        aria-label={o.ariaLabel}
        aria-pressed={o.value === selected ? 'true' : 'false'}
      >
        {o.label}{o.note && <span class="segmented__note">{o.note}</span>}
      </button>
    ))}
  </div>
</div>

<script>
  for (const group of document.querySelectorAll<HTMLElement>('[data-segmented]')) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('.segmented__button')];

    const select = (btn: HTMLButtonElement) => {
      if (btn.getAttribute('aria-pressed') === 'true') return;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
      group.dispatchEvent(
        new CustomEvent('segmentchange', {
          bubbles: true,
          detail: { name: group.dataset.segmented, value: btn.dataset.value },
        }),
      );
    };

    for (const btn of buttons) {
      btn.addEventListener('click', () => select(btn));
      btn.addEventListener('keydown', (e) => {
        // Buttons hidden in the current view are skipped.
        const shown = buttons.filter((b) => !b.hidden);
        const i = shown.indexOf(btn);
        const next =
          e.key === 'ArrowRight' ? shown[Math.min(i + 1, shown.length - 1)] :
          e.key === 'ArrowLeft' ? shown[Math.max(i - 1, 0)] :
          e.key === 'Home' ? shown[0] :
          e.key === 'End' ? shown[shown.length - 1] :
          null;
        if (next) {
          e.preventDefault();
          next.focus();
          select(next);
        }
      });
    }
  }
</script>

<style>
  .segmented {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
  }
  .segmented__buttons {
    display: inline-flex;
    flex-wrap: wrap;
  }
  .segmented__button {
    appearance: none;
    margin: 0 0 0 -1px;
    padding: 7px var(--sp-4);
    min-height: 36px;
    border: 1px solid var(--ink-3);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-label);
    font-size: var(--fs-2);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.2;
    cursor: pointer;
  }
  @media (max-width: 639.98px) {
    .segmented--scroll {
      flex-wrap: nowrap;
      flex-direction: column;
      align-items: stretch;
      /* As a flex or grid item, never grow to the row's full length. */
      width: 100%;
      min-width: 0;
    }
    .segmented--scroll .segmented__buttons {
      flex-wrap: nowrap;
      overflow-x: auto;
      /* Room for the focus outline inside the scroller. */
      padding: 4px;
      margin: -4px;
      scrollbar-width: thin;
    }
    .segmented--scroll .segmented__button { flex: none; }
  }
  .segmented__button[hidden] { display: none; }
  .segmented__note {
    margin-left: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .segmented--compact .segmented__button {
    padding: 5px var(--sp-2);
    min-height: 32px;
    font-size: var(--fs-1);
  }
  @media (min-width: 640px) {
    .segmented--compact .segmented__button { padding-inline: var(--sp-2); font-size: var(--fs-2); }
  }
  .segmented__button:first-child {
    margin-left: 0;
    border-radius: var(--radius-control) 0 0 var(--radius-control);
  }
  .segmented__button:last-child {
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
  }
  .segmented__button:hover {
    background: var(--paper-2);
  }
  .segmented__button[aria-pressed='true'] {
    position: relative;
    z-index: 1;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .segmented__button:focus-visible {
    position: relative;
    z-index: 2;
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
</style>
