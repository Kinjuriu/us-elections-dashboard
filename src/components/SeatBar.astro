---
// A horizontal bar of squares, one per seat (or per N seats), modelled on
// AP's balance-of-power bar (reference/screenshots/03). Pure SVG at build time.
//
// Seats fill column by column, left to right, so each party reads as one
// block: Democrats from the left, Republicans from the right, everything
// else (independents, other parties, vacancies, missing data) in between.
// Independents sit next to the party they caucus with.

interface Props {
  /** Chamber name shown above the bar, e.g. "House". */
  label: string;
  total: number;
  threshold: number;
  /** Seats won. `null` means not yet entered: the bar shows them as missing. */
  dem: number | null;
  gop: number | null;
  /** Seats leading but not called. Not included in dem / gop. */
  demLeading?: number;
  gopLeading?: number;
  /** Seats that changed party. A subset of dem / gop. */
  demFlipped?: number;
  gopFlipped?: number;
  /** Independents, by caucus. Unknown caucus goes in indUnknown. */
  indDem?: number;
  indGop?: number;
  indUnknown?: number;
  other?: number;
  vacant?: number;
  seatsPerSquare?: number;
  /** Rows of squares above 640px and below it. */
  rowsWide?: number;
  rowsNarrow?: number;
  provisional?: boolean;
  /** Short line under the label, e.g. "119th Congress, 2025 to 2027". */
  caption?: string;
}

const {
  label, total, threshold, dem, gop,
  demLeading = 0, gopLeading = 0, demFlipped = 0, gopFlipped = 0,
  indDem = 0, indGop = 0, indUnknown = 0, other = 0, vacant = 0,
  seatsPerSquare = 1, rowsWide = 2, rowsNarrow = 4, provisional = false, caption,
} = Astro.props;

type Kind =
  | 'dem' | 'dem-flip' | 'dem-lead' | 'ind-dem'
  | 'other' | 'vacant' | 'ind-unknown' | 'missing'
  | 'ind-gop' | 'gop-lead' | 'gop-flip' | 'gop';

const hasResults = dem !== null && gop !== null;
const known = hasResults
  ? dem + gop + demLeading + gopLeading + indDem + indGop + indUnknown + other + vacant
  : 0;
if (known > total) {
  throw new Error(`SeatBar "${label}": ${known} seats given for a chamber of ${total}.`);
}

const seats: [Kind, number][] = hasResults
  ? [
      ['dem', dem - demFlipped], ['dem-flip', demFlipped], ['dem-lead', demLeading], ['ind-dem', indDem],
      ['other', other], ['vacant', vacant], ['ind-unknown', indUnknown], ['missing', total - known],
      ['ind-gop', indGop], ['gop-lead', gopLeading], ['gop-flip', gopFlipped], ['gop', gop - gopFlipped],
    ]
  : [['missing', total]];

// Seats to squares. With N seats per square, round by largest remainder so
// the squares still add up to round(total / N).
const nSquares = Math.round(total / seatsPerSquare);
const raw = seats.map(([k, n]) => [k, n / seatsPerSquare] as const);
const floors = raw.map(([k, v]) => [k, Math.floor(v), v - Math.floor(v)] as const);
let spare = nSquares - floors.reduce((s, [, f]) => s + f, 0);
const counts = new Map<Kind, number>(floors.map(([k, f]) => [k, f]));
[...floors].sort((a, b) => b[2] - a[2]).forEach(([k]) => {
  if (spare > 0) { counts.set(k, (counts.get(k) ?? 0) + 1); spare--; }
});
const squares: Kind[] = seats.flatMap(([k]) => Array<Kind>(counts.get(k) ?? 0).fill(k));

const CELL = 10;
const GAP = 2;
const PITCH = CELL + GAP;

function layout(rows: number) {
  const cols = Math.ceil(squares.length / rows);
  const width = cols * PITCH - GAP;
  const height = rows * PITCH - GAP;
  const rects = squares.map((kind, i) => ({
    kind,
    x: Math.floor(i / rows) * PITCH,
    y: (i % rows) * PITCH,
  }));
  // The majority marker sits over the middle seat of the chamber.
  const markerX = ((nSquares / 2) / rows) * PITCH - GAP / 2;
  return { width, height, rects, markerPct: (markerX / width) * 100 };
}

const wide = layout(rowsWide);
const narrow = layout(rowsNarrow);

// Unique pattern ids for each bar on the page.
const uid = `sb${(globalThis as { __seatBarCount?: number }).__seatBarCount =
  ((globalThis as { __seatBarCount?: number }).__seatBarCount ?? 0) + 1}`;

const fill: Record<Kind, string> = {
  dem: 'var(--dem)',
  'dem-flip': `url(#${uid}-hatch-dem)`,
  'dem-lead': 'var(--dem-tint)',
  'ind-dem': 'var(--ind)',
  other: 'var(--ink-3)',
  vacant: 'var(--paper)',
  'ind-unknown': 'var(--ind)',
  missing: 'var(--no-race)',
  'ind-gop': 'var(--ind)',
  'gop-lead': 'var(--gop-tint)',
  'gop-flip': `url(#${uid}-hatch-gop)`,
  gop: 'var(--gop)',
};
const outlined: Kind[] = ['vacant', 'missing'];

const fmt = (n: number) => n.toLocaleString('en-US');
const plural = (n: number, one: string, many: string) => `${fmt(n)} ${n === 1 ? one : many}`;

// Key: only the categories that appear, beyond plain won seats.
const key: { kind: Kind; text: string }[] = [];
if (indDem) key.push({ kind: 'ind-dem', text: `${plural(indDem, 'independent', 'independents')} who caucus with the Democrats` });
if (indGop) key.push({ kind: 'ind-gop', text: `${plural(indGop, 'independent', 'independents')} who caucus with the Republicans` });
if (indUnknown) key.push({ kind: 'ind-unknown', text: `${plural(indUnknown, 'independent', 'independents')}, caucus not known` });
if (other) key.push({ kind: 'other', text: `${plural(other, 'member', 'members')} of another party` });
if (vacant) key.push({ kind: 'vacant', text: `${plural(vacant, 'vacant seat', 'vacant seats')}` });
if (demFlipped || gopFlipped) key.push({ kind: 'dem-flip', text: 'Flipped seat' });
if (demLeading || gopLeading) key.push({ kind: 'dem-lead', text: 'Leading, not yet called' });
const missingSeats = hasResults ? total - known : total;
if (missingSeats) key.push({ kind: 'missing', text: `${plural(missingSeats, 'seat', 'seats')} not yet entered` });

const summary = hasResults
  ? `${label}: ${fmt(dem)} Democrats, ${fmt(gop)} Republicans` +
    (indDem + indGop + indUnknown ? `, ${fmt(indDem + indGop + indUnknown)} independents` : '') +
    (other ? `, ${fmt(other)} other` : '') +
    (vacant ? `, ${fmt(vacant)} vacant` : '') +
    (missingSeats ? `, ${fmt(missingSeats)} not yet entered` : '') +
    `. ${fmt(threshold)} seats for a majority.` +
    (provisional ? ' Provisional.' : '')
  : `${label}: results not yet entered. ${fmt(threshold)} seats for a majority.`;
---
<div class="seat-bar">
  <div class="seat-bar__top">
    <div class="seat-bar__chamber">
      <span class="label">{label}</span>
      {provisional && <span class="seat-bar__prov label">Provisional</span>}
      {caption && <span class="seat-bar__caption">{caption}</span>}
    </div>
  </div>

  <div class="seat-bar__totals" aria-hidden="true">
    <p class="seat-bar__party seat-bar__party--dem">
      <span class="seat-bar__num num">{hasResults ? fmt(dem) : 'n/a'}</span>
      <span class="seat-bar__name">Democrats</span>
    </p>
    <p class="seat-bar__party seat-bar__party--gop">
      <span class="seat-bar__num num">{hasResults ? fmt(gop) : 'n/a'}</span>
      <span class="seat-bar__name">Republicans</span>
    </p>
  </div>

  <div class="seat-bar__graphic" role="img" aria-label={summary}>
    {[['wide', wide], ['narrow', narrow]].map(([variant, g]) => {
      const L = g as ReturnType<typeof layout>;
      return (
        <div class={`seat-bar__variant seat-bar__variant--${variant}`}>
          <div class="seat-bar__marker" style={`left:${L.markerPct.toFixed(3)}%`}>
            <span class="seat-bar__marker-num num">{fmt(threshold)}</span>
            <svg class="seat-bar__triangle" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
              <path d="M0 0H10L5 6Z" fill="var(--ink-2)" />
            </svg>
          </div>
          <svg
            class="seat-bar__svg"
            viewBox={`0 0 ${L.width} ${L.height}`}
            preserveAspectRatio="xMidYMid meet"
            aria-hidden="true"
          >
            <defs>
              {(['dem', 'gop'] as const).map((p) => (
                <pattern id={`${uid}-hatch-${p}`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <rect width="4" height="4" fill={`var(--${p}-tint)`} />
                  <rect width="2" height="4" fill={`var(--${p})`} />
                </pattern>
              ))}
            </defs>
            {L.rects.map((r) => (
              <rect
                x={r.x + (outlined.includes(r.kind) ? 0.5 : 0)}
                y={r.y + (outlined.includes(r.kind) ? 0.5 : 0)}
                width={CELL - (outlined.includes(r.kind) ? 1 : 0)}
                height={CELL - (outlined.includes(r.kind) ? 1 : 0)}
                fill={fill[r.kind]}
                stroke={outlined.includes(r.kind) ? 'var(--ink-3)' : undefined}
                stroke-width={outlined.includes(r.kind) ? 1 : undefined}
                vector-effect={outlined.includes(r.kind) ? 'non-scaling-stroke' : undefined}
              />
            ))}
          </svg>
        </div>
      );
    })}
  </div>

  <ul class="seat-bar__key">
    <li class="seat-bar__key-item">
      <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M0 0H10L5 6Z" fill="var(--ink-2)" /></svg>
      {fmt(threshold)} seats for a majority
    </li>
    {seatsPerSquare > 1 && (
      <li class="seat-bar__key-item">One square = {fmt(seatsPerSquare)} seats</li>
    )}
    {key.map((k) => (
      <li class="seat-bar__key-item">
        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
          {k.kind === 'dem-flip' ? (
            <>
              <defs>
                <pattern id={`${uid}-key-hatch`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <rect width="4" height="4" fill="var(--paper)" />
                  <rect width="2" height="4" fill="var(--ink-2)" />
                </pattern>
              </defs>
              <rect width="10" height="10" fill={`url(#${uid}-key-hatch)`} />
            </>
          ) : k.kind === 'dem-lead' ? (
            <>
              <rect width="5" height="10" fill="var(--dem-tint)" />
              <rect x="5" width="5" height="10" fill="var(--gop-tint)" />
            </>
          ) : outlined.includes(k.kind) ? (
            <rect x="0.5" y="0.5" width="9" height="9" fill={fill[k.kind]} stroke="var(--ink-3)" />
          ) : (
            <rect width="10" height="10" fill={fill[k.kind]} />
          )}
        </svg>
        {k.text}
      </li>
    ))}
  </ul>
</div>

<style>
  .seat-bar {
    min-width: 0;
  }
  .seat-bar__chamber {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-3);
    padding-bottom: var(--sp-2);
  }
  .seat-bar__prov {
    padding: 1px var(--sp-1);
    border: 1px solid var(--ink);
    border-radius: var(--radius-control);
    font-size: 0.75rem;
  }
  .seat-bar__caption {
    font-size: var(--fs-1);
    color: var(--ink-2);
  }
  .seat-bar__totals {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--sp-4);
  }
  .seat-bar__party {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .seat-bar__party--gop { text-align: right; align-items: flex-end; }
  .seat-bar__num {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: var(--fs-6);
    line-height: 1;
  }
  .seat-bar__party--dem .seat-bar__num { color: var(--dem); }
  .seat-bar__party--gop .seat-bar__num { color: var(--gop); }
  .seat-bar__name {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: var(--fs-3);
    margin-top: var(--sp-1);
  }

  .seat-bar__graphic { margin-top: var(--sp-2); }
  .seat-bar__variant { position: relative; padding-top: 26px; }
  .seat-bar__variant--narrow { display: none; }
  @media (max-width: 639.98px) {
    .seat-bar__variant--wide { display: none; }
    .seat-bar__variant--narrow { display: block; }
  }
  .seat-bar__svg { width: 100%; height: auto; }

  .seat-bar__marker {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .seat-bar__marker-num {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: var(--fs-1);
    line-height: 1;
    color: var(--ink);
  }

  .seat-bar__key {
    list-style: none;
    padding: 0;
    margin: var(--sp-3) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    font-size: var(--fs-1);
    color: var(--ink-2);
  }
  .seat-bar__key-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .seat-bar__key-item svg { flex: none; }
</style>
