---
// The map: Senate results or House delegations by state, for every even
// year from 2000. Everything is drawn here at build time for the default
// view (latest Senate year), so it reads correctly with JavaScript off.
// src/scripts/congress-map.ts then follows the shared store (year, chamber,
// selected state, comparison year; the controls are in ControlBar.astro)
// and runs the tooltip and the state view beside the map.
//
// Style reference: reference/screenshots/11 and 12 (dark carved water,
// tracked title block bottom-left), with AP and NYT conventions for the
// data (01, 02, 10).
import { loadMapData, defaultYear } from '../lib/mapData';
import { loadHeaderYears } from '../lib/dashboardData';
import { buildGeo, LAYOUTS } from '../lib/geo';
import { senateTitle, senateTone, hatchParty, ariaLabel, nationalHtml, SPLIT_FILLS, type NationalHeader } from '../lib/mapText';


const data = loadMapData();
const geo = buildGeo(data.apportionments);

// The latest year with results; 2026 once its results are entered.
const year = defaultYear(data);
const senate = data.senate[year];
const house = data.house[year];
const title = senateTitle(senate);

const regions = ['l48', 'ak', 'hi'] as const;
const matrix = (t: { s: number; tx: number; ty: number }) =>
  `matrix(${+t.s.toFixed(5)} 0 0 ${+t.s.toFixed(5)} ${+t.tx.toFixed(2)} ${+t.ty.toFixed(2)})`;
const statesIn = (r: string) => Object.keys(geo.states).filter((st) => geo.states[st].region === r).sort();

// Default (no-JS) state of each shape and label.
const fillOf = (st: string) => senate.states[st]?.fill ?? 'no-race';
const splitOf = (st: string) => senate.states[st]?.split ?? null;
const flippedOf = (st: string) => senate.states[st]?.flipped ?? false;
const hatchOf = (st: string) => (flippedOf(st) ? hatchParty(fillOf(st)) : '');
const name = (st: string) => data.stateNames[st];

// Patterns live in each region's own coordinates, which the layout scales;
// sizes are divided by that scale so stripes are 2px wide on screen.
const patternCss = LAYOUTS.flatMap((spec) => regions.flatMap((r) => {
  const g = `.cm-${spec.id}-${r}`;
  return [
    `${g} .cmap__state[data-fill="pending"]{fill:url(#cm-${spec.id}-${r}-pending)}`,
    ...(['dem', 'gop', 'ind'] as const).map((p) => `${g} .cmap__hatch[data-hatch="${p}"]{fill:url(#cm-${spec.id}-${r}-hatch-${p})}`),
  ];
})).join('\n') + '\n' +
  // Split states: one half each colour, on a hard diagonal (regular race top-left).
  SPLIT_FILLS.flatMap((a) => SPLIT_FILLS.filter((b) => b !== a).map((b) =>
    `.cmap__state[data-fill="split"][data-split="${a}|${b}"]{fill:url(#cm-split-${a}-${b})}`)).join('\n');

const SPLIT_COLOUR: Record<string, string> = {
  dem: 'var(--dem)', gop: 'var(--gop)', ind: 'var(--ind)', other: 'var(--ink-3)',
  'dem-lead': 'var(--dem-tint)', 'gop-lead': 'var(--gop-tint)', 'ind-lead': 'var(--ind)', pending: 'var(--paper)',
};

// What the island needs, and nothing it does not.
const clientData: Record<string, unknown> = {
  ...data,
  stateOrder: geo.stateOrder,
  regions: Object.fromEntries(Object.entries(geo.states).map(([st, s]) => [st, s.region])),
  layouts: geo.layouts.map((l) => ({
    id: l.spec.id,
    media: l.spec.media,
    width: l.spec.width,
    height: l.spec.height,
    cell: l.spec.cell,
    gap: l.spec.gap,
    anchors: Object.fromEntries(Object.entries(l.anchors).map(([st, [x, y]]) => [st, [+x.toFixed(1), +y.toFixed(1)]])),
    house: l.house,
  })),
};
// What the national panel says about each year's Congress.
const headerYears = loadHeaderYears(data);
const header: Record<number, NationalHeader> = Object.fromEntries(Object.entries(headerYears).map(([y, h]) => [y, {
  congress: h.congress,
  yearsServed: h.yearsServed,
  note: h.note,
  senateNote: h.senate.majorityNote,
  unverifiedInd: h.senate.unverifiedInd || h.house.unverifiedInd,
}]));
clientData.header = header;
const nationalDefault = nationalHtml('senate', year, data, header[year], null);
---
<div class="cmap" data-cmap data-view="senate" data-year={year}>
  <style set:html={patternCss}></style>


  <div class="cmap__body">
    <div class="cmap__map">
      <button type="button" class="cmap__kb visually-hidden" data-kb>Map of states. Press an arrow key to move between states and Enter to open the one you are on.</button>
      <p class="visually-hidden" role="status" aria-live="polite" data-kb-live></p>
      <div class="cmap__titleblock">
        <p class="cmap__title" data-title>{title.title}</p>
        <p class="cmap__subtitle" data-subtitle>{title.subtitle}</p>
      </div>

      <!-- Shared geometry, placed by each layout below. -->
      <svg class="cmap__defs" width="0" height="0" aria-hidden="true" focusable="false">
        <defs>
          {SPLIT_FILLS.flatMap((a) => SPLIT_FILLS.filter((b) => b !== a).map((b) => (
            <linearGradient id={`cm-split-${a}-${b}`} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0.5" style={`stop-color:${SPLIT_COLOUR[a]}`} />
              <stop offset="0.5" style={`stop-color:${SPLIT_COLOUR[b]}`} />
            </linearGradient>
          )))}
          {Object.entries(geo.states).map(([st, s]) => (
            <path id={`cm-st-${st}`} d={s.d} vector-effect="non-scaling-stroke" />
          ))}
          {regions.map((r) => (
            <>
              <path id={`cm-land-${r}`} d={geo.layers[r].land} vector-effect="non-scaling-stroke" />
              <path id={`cm-lakes-${r}`} d={geo.layers[r].lakes} />
              <g id={`cm-bathy-${r}`}>
                {geo.layers[r].bathymetry.map((b) => (
                  <path d={b.d} data-depth={b.depth} vector-effect="non-scaling-stroke" />
                ))}
              </g>
            </>
          ))}
        </defs>
      </svg>

      {geo.layouts.map((l) => {
        const { spec } = l;
        const id = spec.id;
        return (
          <div class={`cmap__layout cmap__layout--${id}`} data-layout={id} style={`aspect-ratio:${spec.width}/${spec.height}`}>
            <svg
              class="cmap__svg"
              viewBox={`0 0 ${spec.width} ${spec.height}`}
              role="group"
              aria-label="Map of the United States. Select a state for its result. For the keyboard, use the map control before it.""
            >
              <defs>
                {regions.map((r) => {
                  const s = l.transforms[r].s;
                  const w = +(4 / s).toFixed(3);
                  return (
                    <>
                      {(['dem', 'gop', 'ind'] as const).map((p) => (
                        <pattern id={`cm-${id}-${r}-hatch-${p}`} width={w} height={w} patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                          <rect width={w} height={w} fill={p === 'ind' ? 'var(--paper)' : `var(--${p}-tint)`} />
                          <rect width={w / 2} height={w} fill={`var(--${p})`} />
                        </pattern>
                      ))}
                      <pattern id={`cm-${id}-${r}-pending`} width={w} height={w} patternUnits="userSpaceOnUse">
                        <rect width={w} height={w} fill="var(--paper)" />
                        <circle cx={w / 2} cy={w / 2} r={+(0.7 / s).toFixed(3)} fill="var(--ink-3)" />
                      </pattern>
                    </>
                  );
                })}
                <clipPath id={`cm-${id}-clip-ak`}><rect x={spec.ak[0]} y={spec.ak[1]} width={spec.ak[2]} height={spec.ak[3]} /></clipPath>
                <clipPath id={`cm-${id}-clip-hi`}><rect x={spec.hi[0]} y={spec.hi[1]} width={spec.hi[2]} height={spec.hi[3]} /></clipPath>
              </defs>

              <rect class="cmap__ocean" width={spec.width} height={spec.height} />

              {regions.map((r) => {
                const box = r === 'l48' ? null : spec[r];
                return (
                  <g clip-path={box ? `url(#cm-${id}-clip-${r})` : undefined}>
                    {box && <rect class="cmap__ocean" x={box[0]} y={box[1]} width={box[2]} height={box[3]} />}
                    <g class={`cmap__region cm-${id}-${r}`} data-region={r} transform={matrix(l.transforms[r])}>
                      <use href={`#cm-bathy-${r}`} class="cmap__contours" />
                      <use href={`#cm-land-${r}`} class="cmap__land" />
                      <use href={`#cm-lakes-${r}`} class="cmap__lakes" />
                      {statesIn(r).map((st) => (
                        <use
                          href={`#cm-st-${st}`}
                          class="cmap__state"
                          data-state={st}
                          data-fill={fillOf(st)}
                          data-split={splitOf(st)?.join('|')}
                          data-label={ariaLabel('senate', st, name(st), senate, house)}
                        />
                      ))}
                      {statesIn(r).map((st) => (
                        <use href={`#cm-st-${st}`} class="cmap__hatch" data-state={st} data-hatch={hatchOf(st)} aria-hidden="true" />
                      ))}
                      <use class="cmap__ring cmap__ring--hover" aria-hidden="true" />
                      <use class="cmap__ring cmap__ring--outer" aria-hidden="true" />
                      <use class="cmap__ring cmap__ring--inner" aria-hidden="true" />
                    </g>
                  </g>
                );
              })}
              <rect class="cmap__inset-rule" x={spec.ak[0] + 0.5} y={spec.ak[1] + 0.5} width={spec.ak[2] - 1} height={spec.ak[3] - 1} />
              <rect class="cmap__inset-rule" x={spec.hi[0] + 0.5} y={spec.hi[1] + 0.5} width={spec.hi[2] - 1} height={spec.hi[3] - 1} />

              <g class="cmap__leaders cmap__leaders--senate" aria-hidden="true">
                {l.senateLabels.filter((s) => s.leader).map((s) => (
                  <line class={s.onLand ? 'cmap__leader--land' : undefined} x1={s.leader![0][0]} y1={s.leader![0][1]} x2={s.leader![1][0]} y2={s.leader![1][1]} />
                ))}
              </g>
              <g class="cmap__leaders cmap__leaders--house" aria-hidden="true"></g>
              <g class="cmap__squares" aria-hidden="true"></g>
            </svg>

            <div class="cmap__labels cmap__labels--senate" aria-hidden="true">
              {l.senateLabels.map((s) => (
                <span
                  class={`cmap__label cmap__label--${s.align}${s.badgeBelow ? ' cmap__label--stack' : ''}`}
                  data-state={s.state}
                  data-callout={s.callout ? '' : undefined}
                  data-tone={s.callout ? (s.onLand ? 'land' : 'water') : senateTone(fillOf(s.state), flippedOf(s.state), splitOf(s.state))}
                  style={`left:${s.x}%;top:${s.y}%`}
                >
                  <span class="cmap__code">{s.state}</span>
                  <span class="cmap__races" hidden={(senate.states[s.state]?.races.length ?? 0) < 2}>2</span>
                  <span class="cmap__changed" hidden></span>
                </span>
              ))}
            </div>
            <div class="cmap__labels cmap__labels--house" aria-hidden="true"></div>
          </div>
        );
      })}

      <div class="cmap__tooltip" role="tooltip" hidden></div>
    </div>

    <aside class="cmap__panel" aria-label="State record" data-panel-root>
      <div class="cmap__panel-scroll" tabindex="-1" data-panel-focus>
        <button type="button" class="cmap__clear" data-clear hidden>Close</button>
        <div class="cmap__panel-body" data-panel aria-live="polite" set:html={nationalDefault}></div>
      </div>
    </aside>
  </div>

  <div class="cmap__legendrow">
  <ul class="cmap__legend cmap__legend--senate" aria-label="Key">
    <li><span class="cmap__sw" data-fill="dem"></span>Democrat</li>
    <li><span class="cmap__sw" data-fill="gop"></span>Republican</li>
    <li><span class="cmap__sw" data-fill="ind"></span>Independent</li>
    <li><span class="cmap__sw cmap__sw--flip"></span>Flipped seat</li>
    <li><span class="cmap__sw cmap__sw--lead"></span>Leading, not called</li>
    <li><span class="cmap__sw" data-fill="no-race"></span>No race</li>
    <li><span class="cmap__sw" data-fill="pending"></span>Result not yet entered</li>
    <li><span class="cmap__races cmap__races--key">2</span>Two races: regular and special election</li>
    <li data-split-key hidden={!Object.values(senate.states).some((s) => s.split)}><span class="cmap__sw cmap__sw--split"></span>Split: the two races went different ways (regular top left)</li>
    <li data-compare-key hidden><span class="cmap__changed cmap__changed--key"></span><span data-compare-key-text></span></li>
  </ul>
    <ul class="cmap__legend cmap__legend--house" aria-label="Key">
    <li><span class="cmap__sq" data-kind="dem"></span>Democrat</li>
    <li><span class="cmap__sq" data-kind="gop"></span>Republican</li>
    <li><span class="cmap__sq" data-kind="ind-dem"></span>Independent</li>
    <li><span class="cmap__sq" data-kind="vacant"></span>Vacant</li>
    <li><span class="cmap__sq" data-kind="missing"></span>Not yet entered</li>
    <li>One square per seat, grouped by party</li>
    <li data-compare-key hidden><span class="cmap__changed cmap__changed--key"></span><span data-compare-key-text></span></li>
  </ul>
    <p class="cmap__floor">Years before 2000 show as a faded track on the railway but have no map.</p>
  </div>

  <script type="application/json" data-cmap-data set:html={JSON.stringify(clientData)}></script>
</div>

<script>
  import '../scripts/congress-map';
</script>

<style>
  .cmap {
    --cm-title: clamp(20px, 3.2cqi, 34px);
  }

  /* Legends: inline, small, above the map. */
  .cmap__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    font-size: var(--fs-1);
    color: var(--ink-2);
  }
  .cmap__legend li { display: inline-flex; align-items: center; gap: 6px; }
  .cmap[data-view='senate'] .cmap__legend--house,
  .cmap[data-view='house'] .cmap__legend--senate { display: none; }
  .cmap__sw {
    display: inline-block;
    width: 14px;
    height: 10px;
    flex: none;
  }
  .cmap__sw[data-fill='dem'] { background: var(--dem); }
  .cmap__sw[data-fill='gop'] { background: var(--gop); }
  .cmap__sw[data-fill='ind'] { background: var(--ind); }
  .cmap__sw[data-fill='no-race'] { background: var(--no-race); box-shadow: inset 0 0 0 1px var(--rule); }
  .cmap__sw[data-fill='pending'] {
    background-color: var(--paper);
    background-image: radial-gradient(var(--ink-3) 0.8px, transparent 0.9px);
    background-size: 4px 4px;
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .cmap__sw--flip {
    background: repeating-linear-gradient(45deg, var(--ink-2) 0 1.4px, var(--paper) 1.4px 2.8px);
  }
  .cmap__legend li[hidden] { display: none; }
  .cmap__sw--split {
    background: linear-gradient(135deg, var(--dem) 50%, var(--gop) 50%);
  }
  .cmap__sw--lead {
    background: linear-gradient(90deg, var(--dem-tint) 50%, var(--gop-tint) 50%);
  }
  .cmap__sq {
    display: inline-block;
    width: 9px;
    height: 9px;
    flex: none;
  }
  .cmap__sq[data-kind='dem'] { background: var(--dem); }
  .cmap__sq[data-kind='gop'] { background: var(--gop); }
  .cmap__sq[data-kind='ind-dem'] { background: var(--ind); }
  .cmap__sq[data-kind='vacant'] { background: var(--paper); box-shadow: inset 0 0 0 1px var(--ink-3); }
  .cmap__sq[data-kind='missing'] { background: var(--no-race); box-shadow: inset 0 0 0 1px var(--ink-3); }


  /* ---- Map and side panel: the panel sits under the map, then beside it ---- */
  .cmap__body {
    display: grid;
    min-width: 0;
  }
  @media (min-width: 1100px) {
    .cmap__body {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: stretch;
    }
  }
  .cmap__map {
    position: relative;
    container-type: inline-size;
    min-width: 0;
  }
  .cmap__defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  .cmap__layout { position: relative; display: none; width: 100%; }
  @media (max-width: 639.98px) { .cmap__layout--narrow { display: block; } }
  @media (min-width: 640px) and (max-width: 1023.98px) { .cmap__layout--mid { display: block; } }
  @media (min-width: 1024px) { .cmap__layout--wide { display: block; } }
  .cmap__svg { display: block; width: 100%; height: 100%; }

  .cmap__ocean { fill: var(--ocean); }
  .cmap__contours { fill: none; stroke: var(--ocean-line); stroke-width: 0.75; }
  .cmap__land { fill: var(--land); stroke: var(--land); stroke-width: 0.5; }
  .cmap__lakes { fill: var(--ocean); }
  .cmap__inset-rule { fill: none; stroke: var(--ink-2); stroke-width: 1; vector-effect: non-scaling-stroke; }

  /* States: flat fills, white 0.75px borders. */
  .cmap__state {
    fill: var(--no-race);
    stroke: var(--border);
    stroke-width: 0.75;
    cursor: pointer;
    transition: fill var(--dur-data) var(--ease-data);
  }
  .cmap__state:focus { outline: none; }
  /* The keyboard control is hidden; its focus shows as an outline on the map, and the state it is on gets the ring. */
  .cmap__map:has(.cmap__kb:focus-visible) { outline: 2px solid var(--ink); outline-offset: 2px; }
  .cmap__state[data-fill='dem'] { fill: var(--dem); }
  .cmap__state[data-fill='gop'] { fill: var(--gop); }
  .cmap__state[data-fill='ind'] { fill: var(--ind); }
  .cmap__state[data-fill='other'] { fill: var(--ink-3); }
  .cmap__state[data-fill='dem-lead'] { fill: var(--dem-tint); }
  .cmap__state[data-fill='gop-lead'] { fill: var(--gop-tint); }
  .cmap__state[data-fill='ind-lead'] { fill: var(--ind); }
  .cmap__hatch {
    pointer-events: none;
    stroke: var(--border);
    stroke-width: 0.75;
    opacity: 0;
    fill: none;
    transition: opacity var(--dur-data) var(--ease-data);
  }
  .cmap__hatch[data-hatch='dem'],
  .cmap__hatch[data-hatch='gop'],
  .cmap__hatch[data-hatch='ind'] { opacity: 1; }

  /* House view: plain white states with a hairline, squares on top. */
  .cmap[data-view='house'] .cmap__state { fill: var(--land); stroke: var(--ink-3); stroke-width: 0.5; }
  .cmap[data-view='house'] .cmap__hatch { opacity: 0; }

  /* Hover outline (1px) and the selected or focused state (2px ink, white edge). */
  .cmap__ring { fill: none; pointer-events: none; display: none; }
  .cmap__ring[href] { display: inline; }
  .cmap__ring--hover { stroke: var(--ink); stroke-width: 1; }
  .cmap__ring--outer { stroke: var(--paper); stroke-width: 5; }
  .cmap__ring--inner { stroke: var(--ink); stroke-width: 2; }

  .cmap__leaders :global(line) {
    stroke: var(--paper);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .cmap__leaders line.cmap__leader--land { stroke: var(--ink-2); }
  /* House leaders cross both white land and dark water. */
  .cmap__leaders--house :global(line) { stroke: var(--ink-3); }
  .cmap[data-view='senate'] .cmap__leaders--house,
  .cmap[data-view='senate'] .cmap__squares,
  .cmap[data-view='house'] .cmap__leaders--senate { display: none; }

  /* Seat squares (House view). Same fills as the seat bar. */
  .cmap__squares :global(g) { cursor: pointer; }
  .cmap__squares :global(rect) { transition: fill var(--dur-data) var(--ease-data); }
  .cmap__squares :global(rect[data-kind='dem']) { fill: var(--dem); }
  .cmap__squares :global(rect[data-kind='gop']) { fill: var(--gop); }
  .cmap__squares :global(rect[data-kind='dem-lead']) { fill: var(--dem-tint); }
  .cmap__squares :global(rect[data-kind='gop-lead']) { fill: var(--gop-tint); }
  .cmap__squares :global(rect[data-kind^='ind']) { fill: var(--ind); }
  .cmap__squares :global(rect[data-kind='other']) { fill: var(--ink-3); }
  .cmap__squares :global(rect[data-kind='vacant']) { fill: var(--paper); stroke: var(--ink-2); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .cmap__squares :global(rect[data-kind='missing']) { fill: var(--no-race); stroke: var(--ink-3); stroke-width: 1; vector-effect: non-scaling-stroke; }

  /* ---- Labels (HTML over the map, so text stays at least 12px) ---- */
  .cmap__labels { position: absolute; inset: 0; pointer-events: none; }
  .cmap[data-view='senate'] .cmap__labels--house,
  .cmap[data-view='house'] .cmap__labels--senate { display: none; }
  .cmap__label,
  .cmap__labels :global(.cmap__label) {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 3px;
    transform: translate(-50%, -50%);
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink);
  }
  @media (min-width: 1024px) {
    .cmap__label, .cmap__labels :global(.cmap__label) { font-size: 13px; }
  }
  .cmap__label--start { transform: translate(0, -50%); padding-left: 3px; }
  .cmap__label--end { transform: translate(-100%, -50%); padding-right: 3px; }
  .cmap__label--middle[data-callout] { transform: translate(-50%, -100%); padding-bottom: 2px; }
  .cmap__label[data-tone='dark'],
  .cmap__label[data-tone='water'],
  .cmap__labels :global(.cmap__label[data-tone='water']) { color: var(--paper); }
  .cmap__label[data-callout][data-tone='land'] { color: var(--ink); }
  /* Badge under the code; the code stays on the anchor. */
  .cmap__label--stack { flex-direction: column; gap: 2px; transform: translate(-50%, -7px); }
  /* "2": the state held a regular and a special election that year. */
  .cmap__races {
    display: inline-block;
    min-width: 13px;
    padding: 1px 2px 0;
    border: 1px solid currentColor;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 12px;
    line-height: 11px;
    letter-spacing: 0;
    text-align: center;
  }
  .cmap__races--key { color: var(--ink); }
  /* Compare: a small diamond on states that changed between the two years. */
  .cmap__changed,
  .cmap__labels :global(.cmap__changed) {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 2px;
    flex: none;
