---
import Base from '../layouts/Base.astro';
import ChartFrame from '../components/ChartFrame.astro';
import Footnote from '../components/Footnote.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import Board from '../components/Board.astro';
import ControlChart from '../components/ControlChart.astro';
import MidtermChart from '../components/MidtermChart.astro';
import FlipsChart from '../components/FlipsChart.astro';
import { loadMapData, defaultYear } from '../lib/mapData';
import { loadHeaderYears, storeConfig, stripColumns } from '../lib/dashboardData';
import { loadControlChart, loadMidtermChart, loadFlipsChart } from '../lib/chartData';
import { congressFor } from '../lib/store';
import { ordinal } from '../lib/mapText';
import { compiledContent as sourcesHtml } from '../../data/SOURCES.md';
import {
  loadChamberControl, loadMidtermSwing, loadSenateRaces,
  latestElection, sourceAccessedAt, formatDate,
} from '../lib/data';

// ---------- Data, all read at build time from data/processed/ ----------
const control = loadChamberControl();
const swing = loadMidtermSwing();
const races = loadSenateRaces();

const asOf = (...ids: string[]) => {
  const dates = ids.map(sourceAccessedAt).filter((d): d is Date => d !== null);
  if (!dates.length) throw new Error(`No access date in manifest for ${ids.join(', ')}`);
  return formatDate(new Date(Math.max(...dates.map((d) => d.getTime()))));
};
const CONTROL_SOURCE =
  'US House of Representatives, Office of the Historian; US Senate Historical Office. Seats at the opening of each Congress.';
const MIDTERM_SOURCE =
  'US House of Representatives, Office of the Historian; US Senate Historical Office. Senate counts before each midterm are from election day; counts after are from the opening of the new Congress.';
const controlAsOf = asOf('house_historian_party_divisions', 'senate_party_division');
const senateAsOf = asOf('medsl_senate');

// The newest election with no seat counts yet (2026), if there is one.
const pendingYear = (() => {
  const { newest, withCounts } = latestElection(control, 'house');
  return withCounts && newest.electionYear !== withCounts.electionYear ? newest.electionYear : null;
})();

const houseMidterms = swing.filter((s) => s.chamber === 'house' && !s.isProvisional && s.change !== null);
const midFirst = Math.min(...houseMidterms.map((s) => s.year));
const swingHasProvisional = swing.some((s) => s.isProvisional);
const raceYears = [...new Set(races.filter((r) => !r.isProvisional).map((r) => r.year))];
const flipFirst = Math.min(...raceYears);
const listNames = (xs: string[]) =>
  xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;

// Methodology: SOURCES.md, with its own h1 dropped and headings shifted down.
const sources = (await sourcesHtml())
  .replace(/<h1[^>]*>[\s\S]*?<\/h1>/, '')
  .replace(/<(\/?)h3/g, '<$1h5')
  .replace(/<(\/?)h2/g, '<$1h4');

const mapData = loadMapData();
const dashConfig = storeConfig(mapData);
const headerYears = loadHeaderYears(mapData);
const controlChart = loadControlChart();
const midtermChart = loadMidtermChart();
const flipsChart = loadFlipsChart(mapData);
const columns = stripColumns(controlChart, dashConfig);
const firstClickable = congressFor(Math.min(...dashConfig.years));
const firstClickableStart = controlChart.congresses.find((c) => c.congress === firstClickable)!.startYear;
const ccFirst = controlChart.congresses[0];
const ccLast = controlChart.congresses[controlChart.congresses.length - 1];
const mapLatestYear = Math.max(...mapData.years);
const startYear = defaultYear(mapData);
const defaultSenate = mapData.senate[startYear];
const mapLatestHasResults = mapData.senate[mapLatestYear].decided > 0;
const oddSpecials = races
  .filter((r) => r.year % 2 === 1)
  .map((r) => `${mapData.stateNames[r.state]} in ${r.year}`);
---
<Base
  title="US Congress, 1946 to 2026: who controls the House and Senate"
  description="A map and three charts of how Democrats and Republicans have fared in the House and Senate, with a Congress strip from 1946 and a map from 2000."
>
  <Masthead current="dashboard" />
  <script type="application/json" id="dash-config" set:html={JSON.stringify(dashConfig)}></script>

  <main id="main" class="wrap dash">
    <h1 class="visually-hidden">US Congress, 1946 to 2026: who controls the House and the Senate</h1>

    <Board
      config={dashConfig}
      columns={columns}
      headerYears={headerYears}
      finding={defaultSenate.headline}
      provisional={defaultSenate.provisional}
    />

    <section class="charts" aria-label="History charts">
      <div class="charts__cell">
        <ChartFrame
          title="Who held the majority"
          subtitle={`Seats by party at the opening of each Congress, ${ordinal(ccFirst.congress)} to ${ordinal(ccLast.congress)}. Select one from ${firstClickableStart}.`}
          source={CONTROL_SOURCE}
          dataAsOf={controlAsOf}
        >
          <ControlChart chart={controlChart} selectedCongress={congressFor(dashConfig.defaultYear)} clickableFrom={firstClickable} />
        </ChartFrame>
      </div>
      <div class="charts__cell">
        <ChartFrame
          title="The midterm penalty"
          subtitle={`Seats gained or lost by the president's party in each midterm, ${midFirst} to 2026.`}
          source={MIDTERM_SOURCE}
          dataAsOf={controlAsOf}
        >
          <MidtermChart chart={midtermChart} chamber={dashConfig.defaultChamber} selectedYear={dashConfig.defaultYear} />
        </ChartFrame>
      </div>
      <div class="charts__cell">
        <ChartFrame
          title="Seats that flipped"
          subtitle={`Senate seats won by a different caucus from the one holding them, ${flipFirst} to 2026.`}
          source="MIT Election Data and Science Lab, U.S. Senate statewide returns; official state results for races the dataset lacks."
          dataAsOf={senateAsOf}
        >
          <FlipsChart chart={flipsChart} year={dashConfig.defaultYear} />
        </ChartFrame>
      </div>
    </section>

    <details class="notes" id="notes">
      <summary>Notes and sources</summary>
      <div class="notes__body">
        <div class="notes__list">
          <Footnote>
            Years before 2000 appear on the year strip, coloured by the majority at the opening of each Congress, but
            cannot be selected, because the map starts in 2000. The charts below the map cover the whole period.
          </Footnote>
          <Footnote>
            The band under the controls shows seats at the opening of the Congress elected in the year selected, with one
            square per Senate seat and one per five House seats. The tick marks where a majority starts: 51 senators or
            218 representatives. The House squares on the map show seats won in the November election, from the state
            returns, one per seat, grouped by party within each state rather than by district.
          </Footnote>
          <Footnote>
            A Senate seat counts as flipped when it passes from one party's caucus to the other's, compared with whoever
            held it on election day. Independents count with the party they caucus with. A seat whose party label changed
            but which stayed with the same caucus (for example an independent who caucused with the Democrats replaced by
            a Democrat) is listed with a note and not counted as a flip.
          </Footnote>
          {oddSpecials.length > 0 && (
            <Footnote>
              Special elections held in odd years ({listNames(oddSpecials)}) have their own Senate maps, chosen from the
              year control. They are not in the House view, which has no odd-year elections.
            </Footnote>
          )}
          <Footnote>
            Winners' names are title-cased from the source for display, with hand-checked exceptions such as McConnell and
            DeWine. The data keeps the source's spelling.
          </Footnote>
          {controlChart.notes.map((n) => (
            <Footnote marker={String(n.no)}>
              Majority shown is the party in control for most of the Congress. {n.text}
            </Footnote>
          ))}
          <Footnote>
            In the history chart the bars are drawn to scale rather than as one square per seat, which would be too small
            to see at this size. The line under the chart gives the exact counts for the Congress you point at or select.
          </Footnote>
          <Footnote>
            The House source records only the opening of each Congress, so House "before" counts in the midterm chart are
            from the start of the outgoing Congress, not election day. Some House changes therefore differ by a seat or two
            from the figures usually quoted, which count from election day. Senate "before" counts are from election day;
            "after" counts are from the opening of the new Congress.
          </Footnote>
          {(pendingYear || swingHasProvisional) && (
            <Footnote>
              {pendingYear ?? 2026} is provisional until results are certified. Results are entered as states certify, and
              every {pendingYear ?? 2026} figure is marked until then.{' '}
              {!mapLatestHasResults && `States with a ${mapLatestYear} Senate race are dotted on the map, and the House squares are outlined, until results are entered from official sources.`}
              {pendingYear && ` The ${ordinal(ccLast.congress)} Congress, elected in ${pendingYear}, is shown in grey in the history chart, and the band shows the last Congress with counts.`}
            </Footnote>
          )}
        </div>
        <div class="sources" set:html={sources} />
      </div>
    </details>
  </main>

  <Footer asOf={controlAsOf} />
</Base>

<script>
  // A link to #notes (from the masthead or footer) opens the disclosure.
  const open = () => {
    if (location.hash === '#notes') document.querySelector<HTMLDetailsElement>('#notes')!.open = true;
  };
  open();
  addEventListener('hashchange', open);
</script>

<style>
  .dash { padding-top: var(--sp-4); }
  @media (min-width: 768px) { .dash { padding-top: var(--sp-5); } }

  .charts {
    margin-top: var(--sp-8);
    display: grid;
    gap: var(--sp-8) var(--sp-5);
  }
  @media (min-width: 1024px) {
    .charts { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
  }
  /* The charts pick their narrow or wide drawing from the width of this cell. */
  .charts__cell {
    container: chart / inline-size;
    min-width: 0;
  }

  .notes {
    margin-top: var(--sp-8);
    border-top: 1px solid var(--ink);
  }
  .notes > summary {
    padding-block: var(--sp-3);
    font-family: var(--font-label);
    font-size: var(--fs-2);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
  }
  .notes > summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .notes__body { padding-bottom: var(--sp-5); }
  .notes__list { display: grid; gap: var(--sp-3); }

  .sources {
    max-width: var(--prose-max);
    font-size: var(--fs-2);
  }
  .sources :global(h4) {
    margin-top: var(--sp-7);
    font-size: var(--fs-4);
  }
  .sources :global(h5) {
    margin-top: var(--sp-5);
    font-family: var(--font-label);
    font-size: var(--fs-2);
    font-weight: 600;
  }
  .sources :global(p),
  .sources :global(ul),
  .sources :global(ol),
  .sources :global(table) {
    margin-top: var(--sp-3);
  }
  .sources :global(ul),
  .sources :global(ol) { padding-left: var(--sp-5); }
  .sources :global(li + li) { margin-top: var(--sp-1); }
  .sources :global(a) { overflow-wrap: anywhere; }
  .sources :global(code) {
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  .sources :global(.table-wrap),
  .sources :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--fs-1);
  }
  .sources :global(th) {
    text-align: left;
    font-family: var(--font-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--ink);
    padding: var(--sp-1) var(--sp-3) var(--sp-1) 0;
    vertical-align: bottom;
  }
  .sources :global(td) {
    border-bottom: var(--hairline);
    padding: var(--sp-2) var(--sp-3) var(--sp-2) 0;
    vertical-align: top;
  }

</style>
