---
// US Congress: the map board (railway, map, state panel, Senate and House
// cards) and the two history charts. Governors, Senate flips and the notes
// each have their own page.
import Base from '../layouts/Base.astro';
import ChartFrame from '../components/ChartFrame.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import Board from '../components/Board.astro';
import ControlChart from '../components/ControlChart.astro';
import MidtermChart from '../components/MidtermChart.astro';
import { loadYearControl, CONTROL_AS_OF } from '../lib/pageData';
import { loadMidtermChart } from '../lib/chartData';
import { congressFor } from '../lib/store';
import { ordinal } from '../lib/mapText';
import { hasFirsts } from '../lib/firsts';
import { loadMidtermSwing } from '../lib/data';

// ---------- Data, all read at build time from data/processed/ ----------
const swing = loadMidtermSwing();
const CONTROL_SOURCE =
  'US House of Representatives, Office of the Historian; US Senate Historical Office. Seats at the opening of each Congress.';
const MIDTERM_SOURCE =
  'US House of Representatives, Office of the Historian; US Senate Historical Office. Senate counts before each midterm are from election day; counts after are from the opening of the new Congress.';
const controlAsOf = CONTROL_AS_OF();

const houseMidterms = swing.filter((s) => s.chamber === 'house' && !s.isProvisional && s.change !== null);
const midFirst = Math.min(...houseMidterms.map((s) => s.year));

const { mapData, headerYears, dashConfig, controlChart, columns } = loadYearControl();
const midtermChart = loadMidtermChart();
const firstClickable = congressFor(Math.min(...dashConfig.years));
const firstClickableStart = controlChart.congresses.find((c) => c.congress === firstClickable)!.startYear;
const ccFirst = controlChart.congresses[0];
const ccLast = controlChart.congresses[controlChart.congresses.length - 1];
const startYear = dashConfig.defaultYear;
const defaultSenate = mapData.senate[startYear];
---
<Base
  title="US Congress, 1946 to 2026: who controls the House and Senate"
  description="A map and charts of how Democrats and Republicans have fared in the House and Senate, with a railway of elections and a map from 2000."
>
  <Masthead current="congress" />
  <script type="application/json" id="dash-config" set:html={JSON.stringify(dashConfig)}></script>

  <main id="main" class="wrap dash">
    <header class="title">
      <h1 class="title__h">US Congress, 1946 to 2026</h1>
      <p class="title__sub">Results from {Math.min(...dashConfig.years)} to {Math.max(...dashConfig.years)}</p>
      <p class="title__note">Earlier results may be added later.</p>
    </header>

    <Board
      config={dashConfig}
      columns={columns}
      headerYears={headerYears}
      finding={defaultSenate.headline}
      provisional={defaultSenate.provisional}
    />

    <section class="charts" aria-label="History charts">
      <div class="charts__cell">
        <ChartFrame
          title="Who held the majority"
          subtitle={`Seats by party at the opening of each Congress, ${ordinal(ccFirst.congress)} to ${ordinal(ccLast.congress)}. Select one from ${firstClickableStart}.`}
          source={CONTROL_SOURCE}
          dataAsOf={controlAsOf}
        >
          <ControlChart chart={controlChart} selectedCongress={congressFor(dashConfig.defaultYear)} clickableFrom={firstClickable} />
        </ChartFrame>
      </div>
      <div class="charts__cell">
        <ChartFrame
          title="The midterm penalty"
          subtitle={`Seats gained or lost by the party holding the White House in each midterm, ${midFirst} to 2026.`}
          source={MIDTERM_SOURCE}
          dataAsOf={controlAsOf}
        >
          <MidtermChart chart={midtermChart} chamber={dashConfig.defaultChamber} selectedYear={dashConfig.defaultYear} />
        </ChartFrame>
      </div>
    </section>
    {hasFirsts() && (
      <p class="dash__more">New in 2026: the <a href={`${import.meta.env.BASE_URL}firsts/`} data-carry>Firsts of 2026</a> page lists the milestones in this year's elections.</p>
    )}
  </main>

  <Footer asOf={controlAsOf} />
</Base>

<style>
  .dash__more { margin-top: var(--sp-6); font-size: var(--fs-2); }
  .dash { padding-top: var(--sp-4); }
  @media (min-width: 768px) { .dash { padding-top: var(--sp-5); } }

  .title { margin-bottom: var(--sp-5); }
  .title__h { max-width: none; }
  .title__sub {
    margin-top: var(--sp-2);
    font-size: var(--fs-4);
    font-weight: 500;
  }
  .title__note {
    margin-top: var(--sp-1);
    font-size: var(--fs-1);
    color: var(--ink-2);
  }

  .charts {
    margin-top: var(--sp-8);
    display: grid;
    gap: var(--sp-8) var(--sp-5);
  }
  /* The charts pick their narrow or wide drawing from the width of this cell. */
  .charts__cell {
    container: chart / inline-size;
    min-width: 0;
  }
</style>
